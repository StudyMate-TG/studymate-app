@startuml

left to right direction

skinparam linetype spline
skinparam nodesep 35
skinparam ranksep 40

actor Estudante

rectangle "Sistema StudyMate - Funcionamento Offline" {

    usecase "Consultar tarefas\noffline" as UC16

    usecase "Realizar alterações\nem tarefas offline" as UC17
    usecase "Persistir alteração\nno SQLite" as UC17A
    usecase "Registrar operação\npendente" as UC17B

    usecase "Consultar estado da\nsincronização" as UC19

    UC17 -[hidden]right-> UC17A
    UC17A -[hidden]down-> UC17B

}

Estudante --> UC16
Estudante --> UC17
Estudante --> UC19

UC17 .> UC17A : <<include>>
UC17 .> UC17B : <<include>>


@enduml